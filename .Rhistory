"$140,001-$160,000",
"$160,001-$180,000",
"$180,001-$200,000",
"Over $200,000")),
edu = factor(edu,c("noHS",
"GED",
"2yearColl",
"4yearColl",
"MA",
"PHD")),
county_gini = as.numeric(county_gini),
