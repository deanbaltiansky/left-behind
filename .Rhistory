"MA",
"PHD")))
df_cbzs <- df_cbzs %>%
mutate_at(vars(race_1:race_8),function(x){as.character(x)}) %>%
mutate_at(vars(race_1:race_8),function(x){replace_na(x,"")}) %>%
mutate(race_num_1 = ifelse(race_1 != "",1,0),
race_num_2 = ifelse(race_2 != "",1,0),
race_num_3 = ifelse(race_3 != "",1,0),
race_num_4 = ifelse(race_4 != "",1,0),
race_num_5 = ifelse(race_5 != "",1,0),
race_num_6 = ifelse(race_6 != "",1,0),
race_num_7 = ifelse(race_7 != "",1,0),
race_num_8 = ifelse(race_8 != "",1,0),
race_num = race_num_1 + race_num_2 + race_num_3 + race_num_4 + race_num_5 + race_num_6 + race_num_7 + race_num_8,
race = ifelse(race_num > 1,"multiracial",paste0(race_1,race_2,race_3,race_4,race_5,race_6,race_7,race_8)),
race = ifelse(race == "",NA,race))
df_cbzs <- df_cbzs %>%
rename(ideo_con = ideo_1,
ideo_lib = ideo_2,
ideo_demsoc = ideo_3,
ideo_lbrtn = ideo_4,
ideo_prog = ideo_5,
wc_likely_white = wc_cat_2_1,
wc_likely_black = wc_cat_2_2,
wc_likely_asian = wc_cat_2_3,
wc_likely_hisp = wc_cat_2_4)
df_cbzs <- df_cbzs %>%
mutate(zs_class_3R = 8 - zs_class_3,
reldep_2R = 8 - reldep_2,
reldep_4R = 8 - reldep_4)
df_cbzs <- df_cbzs %>%
mutate(racialgroup = case_when(race == "White" ~ "w",
race == "Asian" ~ "a",
race == "Black or African American" ~ "b",
race == "Hispanic, Latino, or Spanish origin" ~ "h",
.default = "other"))
df_cbzs <- df_cbzs %>%
rowwise() %>%
mutate(zs_class = mean(c(zs_class_1,
zs_class_2,
zs_class_3R),na.rm = T),
reldep = mean(c(reldep_1,
reldep_2R,
reldep_3,
reldep_4R),na.rm = T),
soli = mean(c(soli_1,
soli_2,
soli_3,
soli_4,
soli_5,
soli_6),na.rm = T),
cr_soli_w = ifelse(racialgroup == "w",
mean(c(crs_b_1,
crs_b_2,
crs_a_1,
crs_a_2,
crs_h_1,
crs_h_2),na.rm = T),NA),
cr_soli_b = ifelse(racialgroup == "b",
mean(c(crs_w_1,
crs_w_2,
crs_a_1,
crs_a_2,
crs_h_1,
crs_h_2),na.rm = T),NA),
cr_soli_h = ifelse(racialgroup == "h",
mean(c(crs_b_1,
crs_b_2,
crs_a_1,
crs_a_2,
crs_w_1,
crs_w_2),na.rm = T),NA),
cr_soli_a = ifelse(racialgroup == "a",
mean(c(crs_b_1,
crs_b_2,
crs_w_1,
crs_w_2,
crs_h_1,
crs_h_2),na.rm = T),NA),
cr_soli_o = ifelse(racialgroup == "other",
mean(c(crs_b_1,
crs_b_2,
crs_a_1,
crs_a_2,
crs_h_1,
crs_h_2,
crs_w_1,
crs_w_2),na.rm = T),NA),
cr_soli_w_short = ifelse(racialgroup == "w",
mean(c(crs_b_1,
crs_a_1,
crs_h_1),na.rm = T),NA),
cr_soli_b_short = ifelse(racialgroup == "b",
mean(c(crs_w_1,
crs_a_1,
crs_h_1),na.rm = T),NA),
cr_soli_h_short = ifelse(racialgroup == "h",
mean(c(crs_b_1,
crs_a_1,
crs_w_1),na.rm = T),NA),
cr_soli_a_short = ifelse(racialgroup == "a",
mean(c(crs_b_1,
crs_w_1,
crs_h_1),na.rm = T),NA),
cr_soli_o_short = ifelse(racialgroup == "other",
mean(c(crs_b_1,
crs_a_1,
crs_h_1,
crs_w_1),na.rm = T),NA),
wc_cat_var = sd(c(wc_cat_1_1,
wc_cat_1_2,
wc_cat_1_3,
wc_cat_1_4,
wc_cat_1_5,
wc_cat_1_6),na.rm = T)) %>%
ungroup() %>%
mutate(cr_soli = case_when(racialgroup == "w" ~ cr_soli_w,
racialgroup == "b" ~ cr_soli_b,
racialgroup == "h" ~ cr_soli_h,
racialgroup == "a" ~ cr_soli_a,
racialgroup == "other" ~ cr_soli_o,
.default = NA),
cr_soli_short = case_when(racialgroup == "w" ~ cr_soli_w_short,
racialgroup == "b" ~ cr_soli_b_short,
racialgroup == "h" ~ cr_soli_h_short,
racialgroup == "a" ~ cr_soli_a_short,
racialgroup == "other" ~ cr_soli_o_short,
.default = NA),
wc_cat_whiteshare = wc_cat_1_1)
df_cbzs <- df_cbzs %>%
mutate(is_elg = ifelse(check_1 == "14285733" | is.na(check_1),0,1))
df_cbzs <- df_cbzs %>%
dplyr::select(PID,
zs_class,
soli,
cr_soli,
cr_soli_short,
reldep,
wc_cat_var,
wc_cat_whiteshare,
wc_likely_white:wc_likely_hisp,
zs_class_1,
zs_class_2,
zs_class_3R,
soli_1,
soli_2,
soli_3,
soli_4,
soli_5,
soli_6,
reldep_1,
reldep_2R,
reldep_3,
reldep_4R,
crs_b_1,
crs_b_2,
crs_a_1,
crs_a_2,
crs_h_1,
crs_h_2,
crs_w_1,
crs_w_2,
wc_cat_1_1:wc_cat_1_6,
ideo_con:ideo_prog,
party_id,
check_1,
is_elg,
wrkclass,
age,
gender,
racialgroup,
race,
edu,
income,
ses,
feedback)
write.csv(df_cbzs,"~/Google Drive/My Drive/Class-Based Zero-Sum/nov25/data/df_cbzs.csv",row.names = F)
detachAllPackages <- function() {
basic.packages <- c("package:stats","package:graphics","package:grDevices","package:utils","package:datasets","package:methods","package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:",search()))==1,TRUE,FALSE)]
package.list <- setdiff(package.list,basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package, character.only=TRUE)
}
detachAllPackages()
