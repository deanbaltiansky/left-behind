means <- df_lebe_elg %>%
dplyr::select(PID,trust_con:trust_news) %>%
pivot_longer(-PID,
names_to = "inst",
values_to = "trust") %>%
filter(!is.na(trust)) %>%
group_by(inst) %>%
summarise(score = mean(trust)) %>%
ungroup()
df_lebe_elg %>%
dplyr::select(PID,trust_con:trust_news) %>%
pivot_longer(-PID,
names_to = "inst",
values_to = "trust") %>%
filter(!is.na(trust)) %>%
ggplot(aes(x = trust)) +
geom_histogram(fill = "lightblue",
binwidth = 1) +
scale_x_continuous(breaks = seq(1,4,1),
limits = c(0,5)) +
ylab("count") +
geom_vline(data = means,mapping = aes(xintercept = score),
color = "black",
linetype = "dashed",
size = 1.1) +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
